{
  "name": "chattersnow-web",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docs:links": "bun run tools/check-doc-links.ts",
    "docs:legal": "bun run tools/render-legal-documents.ts",
    "test": "bun test --isolate --path-ignore-patterns=\"e2e/**\" --path-ignore-patterns=\"**/*.integration.test.ts\"",
    "test:integration": "bun --env-file=.env.local test integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:pr": "E2E_BROWSERS=chromium,mobile-chromium playwright test",
    "test:e2e:ci": "playwright test --reporter=blob",
    "test:a11y": "bun run e2e/a11y-scan.ts",
    "test:a11y:check": "bun run e2e/a11y-scan.ts --check",
    "a11y:baseline": "bun run e2e/a11y-scan.ts --update-baseline",
    "verify": "bun run e2e/verify-page.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "husky",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts && prettier --write --log-level warn src/lib/database.types.ts",
    "tenant:provision": "bun --env-file=.env.local scripts/tenant-cli.ts provision",
    "tenant:list": "bun --env-file=.env.local scripts/tenant-cli.ts list",
    "tenant:export": "bun --env-file=.env.local scripts/tenant-cli.ts export",
    "tenant:plan": "bun --env-file=.env.local scripts/tenant-cli.ts plan",
    "tenant:modules": "bun --env-file=.env.local scripts/tenant-cli.ts modules",
    "tenant:archive": "bun --env-file=.env.local scripts/tenant-cli.ts archive",
    "tenant:delete": "bun --env-file=.env.local scripts/tenant-cli.ts delete",
    "tenant:support": "bun --env-file=.env.local scripts/tenant-cli.ts support",
    "demo:reset": "bun --env-file=.env.local scripts/demo-reset.ts",
    "demo:teardown": "bun --env-file=.env.local scripts/demo-reset.ts --teardown"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'next typegen && tsc --noEmit'"
    ]
  },
  "overrides": {
    "fast-uri": "^3.1.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
